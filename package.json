{
  "name": "volc-agent-launchpad",
  "version": "1.0.0",
  "private": true,
  "description": "A middleware-free Agent platform starter kit running Codex CLI locally or on Volcengine ECS.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @launchpad/server\" \"npm run dev -w @launchpad/web\"",
    "build": "npm run build -w @launchpad/web && npm run build -w @launchpad/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/start-local-poc-launcher.test.mjs && npm run test -w @launchpad/server",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "node --env-file-if-exists=.env ./scripts/start-local-poc-launcher.mjs",
    "test:shepherd:live": "SHEPHERD_LIVE_TEST=true node --env-file=.env ./node_modules/vitest/vitest.mjs run --config apps/server/vitest.config.ts apps/server/src/shepherd/live-runtime.integration.test.ts --no-file-parallelism --maxWorkers=1 --bail=1 --retry=0 --testTimeout=1800000 --hookTimeout=120000",
    "test:shepherd:model-review:live": "SHEPHERD_LIVE_TEST=true SHEPHERD_LIVE_MODEL_REVIEW=true node --env-file=.env ./node_modules/vitest/vitest.mjs run --config apps/server/vitest.config.ts apps/server/src/shepherd/live-model-review.integration.test.ts --no-file-parallelism --maxWorkers=1 --bail=1 --retry=0 --testTimeout=600000 --hookTimeout=120000",
    "start": "npm run start -w @launchpad/server"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
