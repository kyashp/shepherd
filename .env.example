# Browser/server
# Safe local default. Docker Compose and Terraform set their own service bind.
HOST=127.0.0.1
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Optional. Empty means the server requires no bearer credential, which is the
# default and is what the local POC runs with. Set 24+ random URL-safe characters
# to require one on every API route, and enter the same token in the browser
# unlock screen. Strongly advised for any deployment reachable beyond this
# machine, where anyone who can reach the port can otherwise drive Agents.
APP_AUTH_TOKEN=

# OpenAI-compatible Responses API. Keep real credentials in ignored .env only.
ARK_API_KEY=replace-with-your-api-key
ARK_MODEL=replace-with-your-agent-model
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional distinct model for Shepherd planning and semantic review.
# Defaults to ARK_MODEL when empty.
SHEPHERD_MODEL=

# Shepherd kernel. Managed repositories, worktrees, and evidence live under
# SHEPHERD_ROOT. The fixed demo API is unavailable unless explicitly enabled;
# its resolved execution mode is reported so deterministic runs are never
# presented as live-model evidence.
SHEPHERD_ROOT=/app/data/shepherd
# Per-execution Codex homes live outside the managed Git/Plane root and are
# owner-scoped, ephemeral, and reconciled after interruption.
SHEPHERD_CODEX_HOME_ROOT=/app/data/shepherd-codex-homes
# auto selects isolated live execution only when Ark is configured and the
# disposable container provider is active. live fails closed otherwise.
SHEPHERD_EXECUTION_MODE=auto
SHEPHERD_DEMO_MODE=false
SHEPHERD_AUTO_RESOLUTION=true
SHEPHERD_DELETE_COMPLETED_PLANES=false
SHEPHERD_MAX_PARALLEL_PLANES=2
SHEPHERD_CONTRACT_TIMEOUT_MS=600000
SHEPHERD_CANDIDATE_TIMEOUT_MS=600000
SHEPHERD_VERIFICATION_TIMEOUT_MS=120000
# Defaults to CONTAINER_RUNTIME_IMAGE when empty.
SHEPHERD_VERIFIER_IMAGE=

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
# Container state volume. Empty keeps host bind mounts, which is correct when the
# control plane runs directly on a Linux host. Set both together to address every
# state root as a subpath of one named volume instead; this is required wherever
# the host filesystem is shared into the container runtime through a virtual
# machine, because such a share cannot carry the Codex sandbox's per-file access
# rights and the Agent then cannot read or write its own workspace. Setting only
# one of the two is a startup error, never a silent fall back to bind mounts.
#
# Both are set for you automatically by ./scripts/start-local-poc.sh whenever its
# probes show the host layout cannot support the sandbox, and by
# docker-compose.state-volume.yml. If you set them by hand, every root below must
# move onto the volume as well, for example
# APP_DATA_DIR=/app/state/data, AGENT_WORKSPACE_ROOT=/app/state/workspaces,
# CODEX_HOME=/app/state/codex-home, SHEPHERD_ROOT=/app/state/data/shepherd and
# SHEPHERD_CODEX_HOME_ROOT=/app/state/data/shepherd-codex-homes. Any root left
# outside CONTAINER_STATE_ROOT fails at startup naming the offending variable.
CONTAINER_STATE_ROOT=
CONTAINER_STATE_VOLUME=
