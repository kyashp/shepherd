ARG NODE_IMAGE=node:22-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker:cli

FROM ${DOCKER_CLI_IMAGE} AS engine-client

FROM ${NODE_IMAGE}
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*

COPY --from=engine-client /usr/local/bin/docker /usr/local/bin/docker
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY --chown=node:node apps ./apps
COPY --chown=node:node scripts ./scripts
RUN mkdir -p /app/.tmp /app/state \
    && chown -R node:node /app/.tmp /app/state

USER node
CMD ["node", "scripts/run-live-vitest.mjs", "runtime"]
