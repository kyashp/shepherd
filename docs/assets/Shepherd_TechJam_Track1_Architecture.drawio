          <mxGeometry height="135" width="240" x="3870" y="1305" as="geometry" />
        </mxCell>
        <mxCell id="materialize" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#374151;" value="&lt;b&gt;General path only&lt;/b&gt;&lt;br&gt;copy exact verified declared artifacts to originating Agent workspace&lt;br&gt;with bounded no-follow operations after CAS" vertex="1">
