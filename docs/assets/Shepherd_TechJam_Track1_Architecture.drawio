        <mxCell id="projection" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Public evidence projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;logical lifecycle, changed-file lists, short Git evidence&lt;br&gt;check status/duration, collision/candidate state&lt;br&gt;session-established boolean only" vertex="1">
          <mxGeometry height="120" width="210" x="205" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="intake" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[2] Normalize + idempotently bind intake&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounded content, secret scan, serialized admission&lt;br&gt;message ID ↔ content fingerprint; mismatched reuse rejected&lt;br&gt;server selects the supported Mission shape" vertex="1">
          <mxGeometry height="125" width="300" x="770" y="347.5" as="geometry" />
        </mxCell>
        <mxCell id="fixed" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Fixed-auth Mission&lt;/b&gt;&lt;br&gt;&lt;br&gt;Frontend + Backend Agents&lt;br&gt;two incompatible recognized transports&lt;br&gt;two independent Contracts / one wave" vertex="1">
          <mxGeometry height="105" width="200" x="690" y="590" as="geometry" />
        </mxCell>
        <mxCell id="general" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Bounded general Mission&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fail-closed clarification&lt;br&gt;1–8 declared artifacts + exact literal check&lt;br&gt;one Agent, one Project, one Contract" vertex="1">
          <mxGeometry height="120" width="200" x="940" y="575" as="geometry" />
        </mxCell>
        <mxCell id="contracts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[3] Persist typed Contract authority&lt;/b&gt;&lt;br&gt;&lt;br&gt;objective, Agent, dependencies, canonical claim key/scope&lt;br&gt;Agent ∩ Contract authority; protected/forbidden paths win&lt;br&gt;immutable Mission base SHA, expected artifacts, trusted check profile&lt;br&gt;reserve Agent identities + persist Mission, Contracts, events atomically" vertex="1">
          <mxGeometry height="155" width="330" x="750" y="805" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;DAG scheduler + concurrency&lt;/b&gt;&lt;br&gt;&lt;br&gt;acyclic dependencies, stable maximal safe batch&lt;br&gt;Agent occupancy, Project mutation lock&lt;br&gt;Plane-capacity and timeout bounds" vertex="1">
          <mxGeometry height="125" width="210" x="670" y="1117.5" as="geometry" />
        </mxCell>
        <mxCell id="state-events" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Actor-gated state machine&lt;/b&gt;&lt;br&gt;&lt;br&gt;no agent_completed → verified edge&lt;br&gt;transition + bounded event in one mutation&lt;br&gt;durable-first cancellation before Runtime cancellation" vertex="1">
          <mxGeometry height="120" width="210" x="940" y="1117.5" as="geometry" />
        </mxCell>
        <mxCell id="control-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#374151;" value="&lt;b&gt;Primary enforcement point&lt;/b&gt;&lt;br&gt;&lt;br&gt;ShepherdService owns intake, Projects, scheduling, execution identities, import, verification, collision, selection, promotion, materialization, cancellation, and restart reconciliation.&lt;br&gt;&lt;br&gt;It never trusts Agent reports and never lets the browser or Agent mutate protected Git." vertex="1">
          <mxGeometry height="155" width="260" x="590" y="1495" as="geometry" />
        </mxCell>
        <mxCell id="managed-repo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Managed Project repository&lt;/b&gt;&lt;br&gt;&lt;br&gt;fixed auth fixture or per-Agent Project&lt;br&gt;server-owned general policy.json + check script&lt;br&gt;protected branch + immutable Mission base SHA" vertex="1">
          <mxGeometry height="140" width="210" x="1420" y="340" as="geometry" />
        </mxCell>
        <mxCell id="plane-manager" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;PlaneManager + argv-only GitClient&lt;/b&gt;&lt;br&gt;&lt;br&gt;server-derived paths / branches / refs beneath sentinel roots&lt;br&gt;sanitized environment · no shell, hooks, credentials, or user refs&lt;br&gt;only component allowed to create worktrees or perform protected CAS" vertex="1">
          <mxGeometry height="110" width="350" x="1900" y="320" as="geometry" />
        </mxCell>
        <mxCell id="contract-a" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[4A] Contract Plane, Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;worktree from identical Mission base SHA&lt;br&gt;authority-filtered Git-free export&lt;br&gt;no linked worktree or protected .git reaches Agent" vertex="1">
          <mxGeometry height="120" width="250" x="1400" y="600" as="geometry" />
        </mxCell>
        <mxCell id="contract-b" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[4B] Contract Plane, Backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;worktree from identical Mission base SHA&lt;br&gt;authority-filtered Git-free export&lt;br&gt;independent execution and session identity" vertex="1">
          <mxGeometry height="105" width="240" x="1895" y="600" as="geometry" />
        </mxCell>
        <mxCell id="runtime-boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;verticalAlign=top;align=left;fontStyle=1;fontSize=17;spacingTop=10;spacingLeft=10;fontColor=#111827;fontSize=13;strokeColor=#444444;" value="UNTRUSTED AGENT EXECUTION : ONE-USE ISOLATED RUNTIME PER CONTRACT" vertex="1">
          <mxGeometry height="390" width="950" x="1305" y="750" as="geometry" />
        </mxCell>
        <mxCell id="runtime-a" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[5A] Fresh Runtime A&lt;/b&gt;&lt;br&gt;&lt;br&gt;deterministic fixture or live Codex&lt;br&gt;fresh private CODEX_HOME, prompt on stdin&lt;br&gt;non-root, read-only root, dropped caps&lt;br&gt;limits + workspace-write sandbox" vertex="1">
          <mxGeometry height="105" width="290" x="1380" y="885" as="geometry" />
        </mxCell>
        <mxCell id="runtime-b" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[5B] Fresh Runtime B&lt;/b&gt;&lt;br&gt;&lt;br&gt;never-reused execution / container / session IDs&lt;br&gt;exactly one fresh thread required&lt;br&gt;raw thread discarded; SHA-256 fingerprint persists&lt;br&gt;Agent-authored files + result manifest" vertex="1">
          <mxGeometry height="140" width="250" x="1890" y="850" as="geometry" />
        </mxCell>
        <mxCell id="engine" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Docker / Colima / Podman&lt;/b&gt;&lt;br&gt;disposable local Runtime boundary" vertex="1">
          <mxGeometry height="58" width="360" x="1340" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="ark" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Volcengine Ark Responses API&lt;/b&gt;&lt;br&gt;reachable only by live Agent control process" vertex="1">
          <mxGeometry height="58" width="360" x="1830" y="1056" as="geometry" />
        </mxCell>
        <mxCell id="import" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[6] Trusted import → authority-valid commit A + commit B&lt;/b&gt;&lt;br&gt;&lt;br&gt;detached no-follow staging at source commit; regular files only&lt;br&gt;reject symlinks, special files, root escapes, protected metadata, tree/size excess&lt;br&gt;derive actual diff → enforce normalized write/forbidden patterns → re-derive and compare&lt;br&gt;strict .shepherd/result.json schema + claim/evidence relevance; manifest then removed&lt;br&gt;rebuild trusted commits from immutable base; Agent commits and control metadata never survive" vertex="1">
          <mxGeometry height="140" width="540" x="1505" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="git-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#374151;" value="&lt;b&gt;Isolation invariant:&lt;/b&gt; Agents never receive protected Git, linked Plane worktrees, verifier storage, browser-selected paths, deployment credentials, or another Shepherd session." vertex="1">
          <mxGeometry height="85" width="195" x="1260" y="1565" as="geometry" />
        </mxCell>
        <mxCell id="registry" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;TrustedCheckRegistry&lt;/b&gt;&lt;br&gt;&lt;br&gt;auth frontend / backend / project-security profiles&lt;br&gt;exact bounded general-content profile&lt;br&gt;server-owned argv only; Agent cannot select commands" vertex="1">
          <mxGeometry height="140" width="290" x="2535" y="305" as="geometry" />
        </mxCell>
        <mxCell id="verifier-isolation" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Verifier isolation contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;one disposable container per check, no network&lt;br&gt;no Ark key, app token, Codex state, Docker socket, or unrelated env&lt;br&gt;read-only root + exact-commit mount CPU/memory/PID/time/output/tmpfs bounds" vertex="1">
          <mxGeometry height="155" width="370" x="2495" y="563" as="geometry" />
        </mxCell>
        <mxCell id="verify" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[7] Independent verification of exact trusted commits&lt;/b&gt;&lt;br&gt;&lt;br&gt;fresh Git-free snapshot of commit A / commit B&lt;br&gt;validate target, checks, path, ownership, and limits&lt;br&gt;untrusted code executes read-only; only verifier actor can certify&lt;br&gt;every mandatory check must have coherent passing evidence" vertex="1">
          <mxGeometry height="140" width="360" x="2500" y="875" as="geometry" />
        </mxCell>
        <mxCell id="evidence" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[8] Bounded redacted evidence + claim corroboration&lt;/b&gt;&lt;br&gt;&lt;br&gt;status, duration, short Git/check evidence; raw stdout/stderr withheld&lt;br&gt;trusted code derives observed auth transport or exact general literal&lt;br&gt;Agent-declared outcomes remain informational until corroborated" vertex="1">
          <mxGeometry height="155" width="350" x="2505" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="integration" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[9] Integration Plane&lt;/b&gt;&lt;br&gt;&lt;br&gt;merge only verified Contract commits from Mission base&lt;br&gt;argv-only Git, textual conflicts abort safely" vertex="1">
          <mxGeometry height="105" width="300" x="2530" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="collision" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;SEMANTIC COLLISION: Git success is not system correctness&lt;/b&gt;&lt;br&gt;&lt;br&gt;different verified Contracts, same normalized key/scope, exclusive mode&lt;br&gt;unequal corroborated values, valid evidence, no dependency supersession&lt;div&gt;&lt;br&gt;&lt;b&gt;example: auth.transport: bearer-jwt ≠ http-only-session-cookie, for the below architecture&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="320" x="3225" y="325" as="geometry" />
        </mxCell>
        <mxCell id="strategies" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[10] Two strategies from the same integration SHA&lt;/b&gt;&lt;br&gt;&lt;br&gt;make the left value true, make the right value true&lt;br&gt;independent Plane / execution / session identities&lt;br&gt;bounded authority across both source scopes" vertex="1">
          <mxGeometry height="165" width="310" x="3230" y="595" as="geometry" />
        </mxCell>
        <mxCell id="candidate-cookie" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[10A] Resolution Plane, COOKIE&lt;/b&gt;&lt;br&gt;&lt;br&gt;target: http-only-session-cookie&lt;br&gt;frontend + backend + project-security checks&lt;br&gt;verifier must corroborate exact persisted target" vertex="1">
          <mxGeometry height="125" width="270" x="3090" y="837.5" as="geometry" />
        </mxCell>
        <mxCell id="candidate-bearer" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[10B] Resolution Plane, BEARER&lt;/b&gt;&lt;br&gt;&lt;br&gt;target: bearer-jwt&lt;br&gt;same profiles, same immutable base&lt;br&gt;target substitution rejected" vertex="1">
          <mxGeometry height="110" width="280" x="3370" y="845" as="geometry" />
        </mxCell>
        <mxCell id="winner" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[11] Deterministic winner policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;exactly one mandatory-pass candidate → select it&lt;br&gt;neither passes → no selection / attention_required&lt;br&gt;both pass → predeclared objective tie-breakers only&lt;br&gt;still tied → human may choose only an eligible verified candidate" vertex="1">
          <mxGeometry height="135" width="310" x="3230" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="attention" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#374151;" value="&lt;b&gt;Fail closed, preserve evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;tie, both fail, paused automation, unsafe result, retry exhausted&lt;br&gt;losing and failed Planes remain inspectable" vertex="1">
          <mxGeometry height="95" width="250" x="3260" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="advisory" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#888888;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#374151;" value="Optional Ark model reviewer receives bounded trusted summaries only; degradation is explicit and its output cannot detect authoritatively, verify, select, or promote." vertex="1">
          <mxGeometry height="85" width="190" x="3060" y="1565" as="geometry" />
        </mxCell>
        <mxCell id="final-gate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[12] PromotionGate: final independent gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;re-read persisted selection + candidate/Plane identity&lt;br&gt;prove immutable candidate HEAD and clean finalized product diff&lt;br&gt;recheck actual-diff authority, fresh independent verification&lt;br&gt;selection must post-date verification&lt;br&gt;recheck expected protected HEAD; any mismatch stops non-green" vertex="1">
          <mxGeometry height="145" width="335" x="3822.5" y="400" as="geometry" />
        </mxCell>
        <mxCell id="promotion-marker" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Durable pre-CAS evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;persist passing evidence + promoting marker&lt;br&gt;cancellation now rejected&lt;br&gt;prove fast-forward ancestry" vertex="1">
          <mxGeometry height="135" width="300" x="3840" y="780" as="geometry" />
        </mxCell>
        <mxCell id="cas" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;[13] Protected fast-forward CAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;atomic update-ref &amp;lt;candidate&amp;gt; &amp;lt;expected&amp;gt;&lt;br&gt;checked-out index/worktree synchronization&lt;br&gt;rollback attempts have distinct evidence" vertex="1">
          <mxGeometry height="110" width="250" x="3865" y="1055" as="geometry" />
        </mxCell>
