        <mxCell id="legacy" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1.5;fillColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=7;fontColor=#111827;" value="&lt;b&gt;Initial Baseline retained&lt;/b&gt;&lt;br&gt;&lt;br&gt;AgentService CRUD/lifecycle&lt;br&gt;Playground + one active Run&lt;br&gt;workspace persistence&lt;br&gt;resumable legacy Codex thread" vertex="1">
          <mxGeometry height="95" width="200" x="320" y="1187.5" as="geometry" />
