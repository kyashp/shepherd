#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git

runcmd:
  - curl -fsSL https://get.docker.com -o /opt/get-docker.sh
  - sh /opt/get-docker.sh
  - systemctl enable --now docker
  - mkdir -p /opt/agent-launchpad
  - git clone --depth 1 --branch '${repository_ref}' '${repository_url}' /opt/agent-launchpad/app
